// ===================== otv/otv.ino =====================
// OTV main sketch: Team H2Woah! (ENES100, Water Sampling)
// setup() and loop() live here. Subsystem code lives in drive.ino,
// mission.ino, nav.ino, tests.ino. Pins/limits/tunables live in config.h.
//
// Build target: -DSIM=1 (default: browser simulator, or the physical ENES100
// Tank on its Mega) or -DSIM=0 (robot).
// Bench tests: -DSIM=0 -DTEST_MODE=1..7. MS5 demos: -DMS5_TASK=n (see config.h).
bool gVisionStarted = false;
bool gRunDone = false; // global, not a static local (the simulator resets those)
void setup() {
  driveSetup();
  missionSetup();
  navSetup();
  // Only start vision when it is needed: hardware bench tests must run
  // without the vision system. Robot MS5 demos (2, 3, 10) don't use vision.
  Enes100.begin(TEAM_NAME, TEAM_TYPE, MARKER_ID, ROOM_NUMBER, VISION_WIFI_TX, VISION_WIFI_RX);
  gVisionStarted = true;
  if (!waitForConnection(WIFI_CONNECT_MS)) logMsg("Vision system not connected, continuing");
  logMsg("Target: SIMULATOR");
  if (!simSpeedOk()) {
    // Stop here: nothing steers correctly at this speed.
    // (No commas: the simulator console drops the space after them.)
    logMsg("STOPPED: simulator speed is too slow.");
    logMsg("1. Click Stop (top-left square).");
    logMsg("2. Click the speed button (2nd from the left) until its tooltip says instant.");
    logMsg("3. Click Run and then Continue again.");
    while (true) {
      stopDrive();
      delay(1000);
    }
  }
}
void loop() {
  runMs5();
}
// ===================== otv/drive.ino =====================
// Drive layer: the ONLY code that touches motor pins or Tank.
// Navigation calls setDrive()/stopDrive() and nothing else, so this
// file is the single switch point between simulator and robot.
// PWM is -255..255 per side (+ = forward), clamped to +/-MAX_PWM.
// ---------------- Simulator: Tank library ----------------
void driveSetup() {
  Tank.begin();
  stopDrive();
}
void setDrive(int left, int right) {
  Tank.setLeftMotorPWM(constrain(left, -MAX_PWM, MAX_PWM));
  Tank.setRightMotorPWM(constrain(right, -MAX_PWM, MAX_PWM));
}
void stopDrive() {
  Tank.turnOffMotors();
}
// ===================== otv/mission.ino =====================
// Mission: arm servos, pump (water sample), ultrasonic (depth),
// color sensor (pollution).
// Robot code is ported from the teammate sketches in teammates/
// (Walter: pump, servo. Adiel: ultrasonic, color), with known bugs fixed.
// ---------------- Simulator: no servos, pump, or water ----------------
void missionSetup() {}
void armDown() { delay(SIM_ARM_MS); }
void armStow() { delay(SIM_ARM_MS); }
void pumpDispenseML(float ml) { delay(SIM_PUMP_MS); }
float readDistanceMM() { return -1; }
int computeDepthMM() { return SIM_DEPTH_MM; }
void readColorRaw(int *r, int *g, int *b) {
  *r = 0;
  *g = 0;
  *b = 0;
}
bool isPolluted() { return SIM_POLLUTED; }
// ---------------- Both targets ----------------
// The pool depth is always 20, 30, or 40 mm: snap to the nearest.
// A failed reading (negative) sends DEPTH_FALLBACK_MM.
int snapDepthMM(int rawMM) {
  if (rawMM < 0) return DEPTH_FALLBACK_MM;
  int d = constrain(rawMM, DEPTH_MIN_MM, DEPTH_MAX_MM);
  int steps = (d - DEPTH_MIN_MM + DEPTH_STEP_MM / 2) / DEPTH_STEP_MM;
  return DEPTH_MIN_MM + steps * DEPTH_STEP_MM;
}
// Each mission() call happens exactly once: graded demos hide prints,
// so results go out as single final mission() calls.
void runMission() {
  logMsg("Mission: arm down");
  armDown();
  delay(ARM_SETTLE_MS);
  int rawDepthMM = computeDepthMM();
  if (rawDepthMM < 0) logMsg("Mission: depth reading FAILED, sending fallback (not data)");
  else logVal("Mission: raw depth mm = ", rawDepthMM);
  int depthMM = snapDepthMM(rawDepthMM);
  bool polluted = isPolluted();
  logMsg("Mission: pumping sample");
  pumpDispenseML(SAMPLE_ML);
  armStow();
  Enes100.mission(DEPTH, depthMM);
  Enes100.mission(WATER_TYPE, polluted ? FRESH_POLLUTED : FRESH_UNPOLLUTED);
  logVal("Mission sent: depth mm = ", depthMM);
  logMsg(polluted ? "Mission sent: polluted" : "Mission sent: unpolluted");
}
